{
  "title": "ObserveX Chaos Dashboard",
  "uid": "chaos-observex",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Pod Restarts",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total[5m])",
          "legendFormat": "{{pod}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 2,
      "title": "Running Pods Count",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase='Running'})",
          "legendFormat": "Running Pods"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 3,
      "title": "CPU Usage",
      "type": "graph",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode='idle'}[2m])) * 100)",
          "legendFormat": "CPU %"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 4,
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "100 * (1 - ((node_memory_MemFree_bytes + node_memory_Cached_bytes + node_memory_Buffers_bytes) / node_memory_MemTotal_bytes))",
          "legendFormat": "Memory %"
        }
      ],
      "datasource": "Prometheus"
    }
  ],
  "schemaVersion": 16,
  "version": 1
}
